# Liquid Gold Backend Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=4000

# SQLite database path (relative to the backend directory)
# Defaults to ./data/liquid-gold.db if not set
DB_PATH=./data/liquid-gold.db

# IBM watsonx.ai credentials (used to power the AI agent)
# Get these from: https://cloud.ibm.com → watsonx.ai → Manage → Credentials
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
# Region URL — default is us-south; change if your instance is in a different region
# Options: https://us-south.ml.cloud.ibm.com | https://eu-de.ml.cloud.ibm.com | https://jp-tok.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com
# Foundation model to use — granite-3-8b-instruct is fast and free-tier friendly
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# Optional: Alpha Vantage for live market data
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# CORS – frontend origin
FRONTEND_ORIGIN=http://localhost:3000
